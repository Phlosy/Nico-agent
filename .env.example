# Compose project
COMPOSE_PROJECT_NAME=nico-agent-platform
NICO_INSTALL_CONFIG_VERSION=2

# Release images. Source builds may keep these defaults; the installer pins all
# three to the selected GitHub Release tag.
NICO_BACKEND_IMAGE=nico-agent-backend:local
NICO_HERMES_IMAGE=nico-agent-hermes:local
NICO_WEB_IMAGE=nico-agent-web:local
NICO_RUNTIME=native
NICO_PULL_POLICY=always

# PostgreSQL (development defaults; change before any shared deployment)
POSTGRES_DB=nico_agent
POSTGRES_USER=nico
POSTGRES_PASSWORD=nico-change-me
POSTGRES_PORT=15432
NICO_BIND_ADDRESS=127.0.0.1

# Redis
REDIS_PORT=16379

# MinIO
MINIO_ROOT_USER=nico-minio
MINIO_ROOT_PASSWORD=nico-minio-change-me
MINIO_BUCKET=nico-artifacts
MINIO_API_PORT=19010
MINIO_CONSOLE_PORT=19011

# Published services
API_PORT=18000
WEB_PORT=18080
NICO_LOG_LEVEL=INFO
NICO_DEPENDENCY_TIMEOUT_SECONDS=2
NICO_ARTIFACT_MAX_BYTES=10485760
NICO_CONVERSATION_ATTACHMENT_TTL_SECONDS=86400
NICO_CONVERSATION_ATTACHMENT_EXCERPT_CHARS=16000
NICO_CONVERSATION_ATTACHMENT_MAX_COUNT=16
NICO_CONVERSATION_ATTACHMENT_MAX_TOTAL_BYTES=26214400
NICO_WORKER_HEALTH_INTERVAL_SECONDS=15
NICO_WORKER_POLL_INTERVAL_SECONDS=1
NICO_WORKER_LEASE_SECONDS=30
NICO_WORKER_HEARTBEAT_SECONDS=10
NICO_WORKER_CONCURRENCY=1
NICO_WORKER_ID=nico-worker
NICO_PROVIDER_PROBE_CONCURRENCY=1
NICO_PROVIDER_PROBE_POLL_INTERVAL_SECONDS=1
NICO_PROVIDER_PROBE_LEASE_SECONDS=90
NICO_WORKER_HEALTH_MARKER=/tmp/nico-worker-ready
NICO_MODEL_SECRETS_FILE=./config/model-secrets.env
NICO_TOOL_APPROVAL_REQUIRED_RISKS=["medium","high"]
NICO_TOOL_APPROVAL_TTL_SECONDS=900
NICO_HERMES_ENABLED=false
NICO_HERMES_COMMAND=hermes
# Optional `hermes` profile build input; the default stack ignores it.
HERMES_AGENT_SPEC=hermes-agent[mcp]==0.18.2
# Optional Hermes model Provider credentials. The installer accepts these only
# from existing environment variables or hidden interactive input.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NICO_MODEL_ENDPOINT_WRITES_ENABLED=true
# The packaged Docker profile maps this single hostname to the installation host,
# allowing Other Provider to reach Ollama/vLLM/LM Studio without trusting the LAN.
NICO_MODEL_TRUSTED_PRIVATE_HOSTS=["host.docker.internal"]
NICO_MODEL_ALLOW_HTTP_TRUSTED_HOSTS=true
# Model credentials use logical references such as env:NICO_MODEL_SECRET_OPENAI.
# Set the referenced NICO_MODEL_SECRET_* variable only in your deployment secret store.
NICO_SANDBOX_RUNNER_TOKEN=nico-sandbox-development-token
