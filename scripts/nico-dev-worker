#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export NICO_ENV_PYTHON="$ROOT_DIR/.venv/bin/python"
# shellcheck source=scripts/lib.sh
source "$ROOT_DIR/scripts/lib.sh"

if [[ -f "${NICO_MODEL_SECRETS_FILE:-}" ]]; then
  load_env_values "$NICO_MODEL_SECRETS_FILE"
fi

exec "$ROOT_DIR/.venv/bin/python" -m nico_agent.worker
